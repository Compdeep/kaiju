# Binary (repo-root build output only — anchored so it doesn't match the
# cmd/kaiju/ source directory and silently ignore new files there).
/kaiju
/cmd/kaiju/kaiju
.kaiju
.kaiju-state
*.exe

# Dependencies
node_modules/
web/node_modules/

# Build output (embedded in binary via go:embed)
internal/gateway/web/

# Config with secrets
kaiju.json
*.env

# Database
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Scratch workspace (data_science skill runs `cd project && .venv/bin/python`);
# it's a machine-local venv + generated files, never source.
/project/

# Python caches (from compute/data_science runs)
__pycache__/
*.pyc

# Plugin virtualenv — machine-local Python env (matplotlib, etc.), never source.
plugins/venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
poster_prompt.txt
subculture_selection.txt
business_plan.md
report.json

# Service state — the registry the service tool writes (names, absolute paths,
# pids, ports, crash status) and the stdout/stderr
# logs it rotates. Machine-local, and the logs carry absolute paths and ports
# from whatever ran here. Eight .log.prev files reached the repo before this.
.services/
.services.json

# Logs, wherever they land.
*.log
*.log.prev

# Eval binaries built at the repo root. /kaiju was anchored-ignored and these
# three were not, so 21MB of build output was committed.
/editor_eval
/holmes_eval
/pipeline_eval

# Workspace zones. A run whose workspace is the repo root writes into these —
# fetched pages, command output, uploads, per-session state, generated media.
# None of it is source. See internal/workspace.AllowedZones for the five a plan
# may write to; the rest are written by tools.
/media/
/canvas/
/blueprints/
/uploads/
/sessions/
/fetched/
/output/

# Data files dropped in for a run. ttm.csv was a company expense ledger.
/*.csv
